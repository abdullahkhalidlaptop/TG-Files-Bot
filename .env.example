# ============================================================
# Telegram File Store Bot — Environment Configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real ".env" file to GitHub.
# ============================================================

# Get this from @BotFather after creating your bot
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your personal Telegram numeric user ID (get it from @userinfobot).
# This account becomes the permanent, un-removable OWNER admin.
OWNER_ID=123456789

# Path to the SQLite database file (created automatically on first run)
DB_PATH=filestore.db

# Log file path
LOG_PATH=bot.log
