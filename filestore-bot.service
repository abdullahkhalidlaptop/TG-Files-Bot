[Unit]
Description=Telegram File Store Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit this path to match where you cloned the project on your VPS
WorkingDirectory=/root/telegram-filestore-bot
ExecStart=/root/telegram-filestore-bot/venv/bin/python bot.py
Restart=always
RestartSec=5
# Matches the root-shell, no-sudo workflow this project's README uses.
# Change to a non-root user only if you set one up yourself (and update
# WorkingDirectory/ExecStart above to that user's home directory).
User=root
Environment=PYTHONUNBUFFERED=1

# Basic hardening (safe defaults for a single-purpose bot process)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
